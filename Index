<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>سوبرماركت جوجي - JJ's Supermarket</title>
    <style>
        :root { --primary: #2c3e50; --accent: #27ae60; --danger: #e74c3c; --bg: #f8f9fa; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: var(--bg); margin: 0; padding-bottom: 100px; direction: rtl; }
        header { background-color: var(--primary); color: white; padding: 20px; text-align: center; font-size: 24px; font-weight: bold; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        .search-container { max-width: 800px; margin: 20px auto; padding: 0 15px; display: flex; gap: 10px; }
        .search-container input { flex: 1; padding: 12px 15px; font-size: 16px; border: 1px solid #ccc; border-radius: 8px; outline: none; }
        .container { max-width: 1200px; margin: 0 auto; padding: 15px; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 20px; }
        .product-card { background: white; border-radius: 12px; box-shadow: 0 3px 10px rgba(0,0,0,0.08); padding: 15px; text-align: center; display: flex; flex-direction: column; justify-content: space-between; }
        .product-card h3 { font-size: 18px; margin: 10px 0; color: #333; }
        .category-tag { font-size: 12px; background: #e2e8f0; color: #475569; padding: 3px 8px; border-radius: 4px; display: inline-block; margin-bottom: 8px; }
        .price { color: var(--danger); font-weight: bold; font-size: 18px; margin-bottom: 12px; }
        button { background-color: var(--accent); color: white; border: none; padding: 10px 15px; border-radius: 6px; cursor: pointer; width: 100%; font-size: 16px; font-weight: 600; transition: background 0.2s; }
        button:hover { background-color: #219653; }
        .checkout-section { background: white; max-width: 800px; margin: 30px auto; padding: 25px; border-radius: 12px; box-shadow: 0 3px 10px rgba(0,0,0,0.08); }
        .checkout-section h3 { margin-top: 0; color: var(--primary); }
        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; margin-bottom: 6px; font-weight: bold; color: #444; }
        .form-group input, .form-group textarea { width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 8px; box-sizing: border-box; font-size: 15px; }
        .cart-bar { position: fixed; bottom: 0; left: 0; right: 0; background: var(--primary); color: white; padding: 15px 25px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 -4px 15px rgba(0,0,0,0.2); z-index: 100; font-size: 18px; }
        .cart-bar button { width: auto; background-color: var(--accent); padding: 10px 25px; }
        .loading { text-align: center; padding: 60px; font-size: 20px; color: #666; grid-column: 1 / -1; }
    </style>
</head>
<body>

    <header>🛒 سوبرماركت جوجي - JJ's Supermarket</header>

    <div class="search-container">
        <input type="text" id="search-box" placeholder="ابحث عن منتج (مثال: حليب، أرز، خبز...)" oninput="filterProducts()">
    </div>

    <div class="container" id="product-list">
        <div class="loading" id="loading">جاري تحميل المنتجات من Google Sheets...</div>
    </div>

    <div class="checkout-section">
        <h3>📝 تفاصيل العميل وتأكيد الطلب</h3>
        <div class="form-group">
            <label>اسم العميل:</label>
            <input type="text" id="cust-name" placeholder="أدخل اسمك الكامل">
        </div>
        <div class="form-group">
            <label>رقم الهاتف:</label>
            <input type="text" id="cust-phone" placeholder="07xxxxxxxx">
        </div>
        <div class="form-group">
            <label>عنوان التوصيل:</label>
            <textarea id="cust-address" rows="2" placeholder="المنطقة، الشارع، رقم العمارة، ملاحظات..."></textarea>
        </div>
    </div>

    <div class="cart-bar">
        <div>السلة: <span id="cart-count">0</span> منتجات | المجموع: <span id="total-price">0.00</span> د.أ</div>
        <button onclick="submitOrder()">تأكيد وإرسال عبر الواتساب</button>
    </div>

    <script>
        let products = [];
        let cart = [];

        window.onload = function() {
            google.script.run.withSuccessHandler(function(data) {
                products = data;
                renderProducts(products);
            }).getProducts();
        };

        function renderProducts(items) {
            const list = document.getElementById('product-list');
            if (items.length === 0) {
                list.innerHTML = '<div class="loading">لا توجد منتجات مطابقة أو أن جدول المنتجات فارغ. تأكد من إضافة البيانات في ورقة Products.</div>';
                return;
            }
            list.innerHTML = items.map(p => `
                <div class="product-card">
                    <div>
                        <span class="category-tag">${p.category || 'عام'}</span>
                        <h3>${p.name}</h3>
                    </div>
                    <div>
                        <div class="price">${Number(p.price).toFixed(2)} د.أ</div>
                        <button onclick="addToCart('${p.id}')">إضافة للسلة</button>
                    </div>
                </div>
            `).join('');
        }

        function filterProducts() {
            const query = document.getElementById('search-box').value.toLowerCase();
            const filtered = products.filter(p => p.name.toLowerCase().includes(query) || (p.category && p.category.toLowerCase().includes(query)));
            renderProducts(filtered);
        }

        function addToCart(id) {
            const product = products.find(p => p.id == id);
            if (product) {
                cart.push(product);
                updateCartUI();
            }
        }

        function updateCartUI() {
            document.getElementById('cart-count').innerText = cart.length;
            const total = cart.reduce((sum, item) => sum + Number(item.price), 0);
            document.getElementById('total-price').innerText = total.toFixed(2);
        }

        function submitOrder() {
            if (cart.length === 0) {
                alert("سلة التسوق فارغة! الرجاء اختيار منتجات أولاً.");
                return;
            }
            const name = document.getElementById('cust-name').value.trim();
            const phone = document.getElementById('cust-phone').value.trim();
            const address = document.getElementById('cust-address').value.trim();

            if (!name || !phone || !address) {
                alert("الرجاء تعبئة جميع بيانات العميل (الاسم، رقم الهاتف، وعنوان التوصيل).");
                return;
            }

            let itemsSummary = cart.map(item => `${item.name} (${item.price} د.أ)`).join(', ');
            const total = cart.reduce((sum, item) => sum + Number(item.price), 0).toFixed(2);

            const orderData = {
                name: name,
                phone: phone,
                address: address,
                itemsSummary: itemsSummary,
                total: total
            };

            google.script.run.withSuccessHandler(function() {
                console.log("Order logged successfully");
            }).saveOrder(orderData);

            let message = `🛒 *طلب جديد من JJ's Supermarket*%0A%0A`;
            message += `👤 *العميل:* ${name}%0A`;
            message += `📞 *الهاتف:* ${phone}%0A`;
            message += `📍 *العنوان:* ${address}%0A%0A`;
            message += `📋 *المنتجات المطلوبة:*%0A`;
            cart.forEach((item, index) => {
                message += `${index + 1}. ${item.name} - ${item.price} د.أ%0A`;
            });
            message += `%0A💰 *المجموع الكلي:* ${total} دينار`;

            const whatsappPhone = "962788984458";
            window.open(`https://wa.me/${whatsappPhone}?text=${message}`, '_blank');
        }
    </script>
</body>
</html>
